 static void enum_full_complete(void);
 
+// hid-remapper: the root port went away (e.g. an ATEN USB switch moved to another computer) while a
+// device behind a hub was being enumerated. process_removing_device() only closes addressed devices,
+// so dev0's request on address 0 stayed in the control pipe and _dev0.enumerating stayed set: every
+// later attach was deferred forever, the hub was never configured again and its downstream ports
+// stayed unpowered until a reboot.
+static void enum_abort(uint8_t rhport) {
+  if (_dev0.rhport != rhport) return;
+
+  hcd_device_close(rhport, 0);
+  if (_ctrl_xfer.daddr == 0 && _ctrl_xfer.stage != CONTROL_STAGE_IDLE) {
+    _set_control_xfer_stage(CONTROL_STAGE_IDLE);
+  }
+  _dev0.enumerating = 0;
+  _enum_failed_count = 0;
+  _enum_redo_count = 0;
+}
+
+// hid-remapper: a control transfer or an enumeration that hasn't moved for RECOVERY_STUCK_MS has lost
+// its completion somewhere, and holds up every later attach and control request. Fail the transfer,
+// so its owner sees an error and retries or gives up as it would for any failed request, or give up
+// on an enumeration that has nothing in flight.
+static void recovery_check(void) {
+  bool const ctrl_busy = (_ctrl_xfer.stage != CONTROL_STAGE_IDLE);
+  if (!ctrl_busy && !_dev0.enumerating) return;
+  uint32_t const now = hcd_frame_number(_usbh_controller);
+  if (now - _last_progress_ms < RECOVERY_STUCK_MS) return;
+
+  if (ctrl_busy) {
+    uint8_t const daddr = _ctrl_xfer.daddr;
+    // one endpoint serves both directions of EP0
+    if (!hcd_edpt_abort_xfer(usbh_get_rhport(daddr), daddr, 0) && !_ctrl_lost) {
+      // Nothing in flight: it may have completed just now with its event still queued, and failing
+      // it as well would let that event drive the next transfer. Look again once the queue has run.
+      _ctrl_lost = true;
+      _last_progress_ms = now - RECOVERY_STUCK_MS + RECOVERY_RECHECK_MS;
+      return;
+    }
+    TU_LOG_USBH("[:%u] USBH control transfer stuck, failing it\r\n", daddr);
+    _ctrl_lost = false;
+    _last_progress_ms = now;
+    _control_xfer_complete(daddr, XFER_RESULT_FAILED);
+  } else {
+    TU_LOG_USBH("[%u:] USBH enumeration stuck, giving up\r\n", _dev0.rhport);
+    _last_progress_ms = now;
+    enum_give_up();
+  }
+}
+
+// hid-remapper: upstream ends a failed enumeration and leaves the device dead until it is replugged.
+// A hub then has its downstream ports unpowered and nothing behind it ever comes up. Instead, drop
+// whatever got an address on that port and enumerate it again from a port reset, a few times in a row.
+static void enum_give_up(void) {
+  uint8_t const rhport = _dev0.rhport;
+  uint8_t const hub_addr = _dev0.hub_addr;
+  uint8_t const hub_port = _dev0.hub_port;
+
+  if (_enum_redo_count >= ENUM_REDO_MAX) {
+    enum_full_complete();
+    return;
+  }
+  _enum_redo_count++;
+  TU_LOG_USBH("[%u:%u:%u] USBH enumeration failed, starting over\r\n", rhport, hub_addr, hub_port);
+
+  _dev0.enumerating = 0;
+  process_removing_device(rhport, hub_addr, hub_port);
+  hcd_device_close(rhport, 0);
+
+  #if CFG_TUH_HUB
+  if (hub_addr) {
+    // as for any attach, the hub's status pipe stays idle until this enumeration completes, so the
+    // hub driver doesn't clear the reset change the enumeration looks for
+    if (!hub_port_reenumerate(hub_addr, hub_port)) hub_edpt_status_xfer(hub_addr);
+    return;
+  }
+  #endif
+
+  if (hcd_port_connect_status(rhport)) {
+    hcd_event_t const event = {
+      .rhport = rhport,
+      .event_id = HCD_EVENT_DEVICE_ATTACH,
+      .connection = { .hub_addr = 0, .hub_port = 0 }
+    };
+    queue_event(&event, false);
+  }
+}
