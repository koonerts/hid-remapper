+// hid-remapper: a hub with per-port over-current protection switches the port off, and upstream only
+// cleared the change, so the port stayed unpowered until the hub was configured again. Power it
+// again, a few times at most per hub, so a device that really is shorted doesn't cycle forever.
+static void port_over_current_cleared (tuh_xfer_t* xfer)
+{
+  uint8_t const daddr = xfer->daddr;
+  hub_interface_t* p_hub = get_itf(daddr);
+  uint8_t const port_num = (uint8_t) tu_le16toh(xfer->setup->wIndex);
+
+  if (xfer->result == XFER_RESULT_SUCCESS && !p_hub->port_status.status.port_power && p_hub->oc_repowers < 3) {
+    TU_LOG1("HUB Port %u powered again after over current, addr = %u\r\n", port_num, daddr);
+    p_hub->oc_repowers++;
+    if (hub_port_set_feature(daddr, port_num, HUB_FEATURE_PORT_POWER, hub_clear_feature_complete_stub, 0)) return;
+  }
+  hub_edpt_status_xfer(daddr);
+}
