+
+// PC-like enumeration: some wireless receivers (G-Wolves VUK) expose a single boot-mouse
+// interface unless the host enumerates like Windows/Linux (64-byte device descriptor read,
+// 255-byte config read, string descriptors before SET_CONFIG).
+void tuh_enum_diag_cb(uint8_t stage, uint32_t value) TU_ATTR_WEAK;
+static uint8_t _enum_str_buf[256];
+
+// String descriptor reads are optional; a STALL must not abort enumeration.
+static void enum_str_cb(tuh_xfer_t* xfer) {
+  if (tuh_enum_diag_cb) tuh_enum_diag_cb((uint8_t) (0x10 | xfer->user_data), (uint32_t) xfer->result << 16 | xfer->actual_len);
+  xfer->result = XFER_RESULT_SUCCESS;
+  process_enumeration(xfer);
+}
 
